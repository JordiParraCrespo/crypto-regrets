---
import Base from '../../layouts/Base.astro';
import { allCategoryStats, fmtUsd, href, LAYER_ORDER, CLASSES } from '../../lib/data';
import { CATEGORIES, LAYERS, categoriesInLayer } from '../../lib/taxonomy';
import { classesOf } from '../../lib/classes';
const stat = Object.fromEntries(allCategoryStats.map((s) => [s.id, s]));
---
<Base title="Failure patterns" description="17 failure patterns across 6 layers of the stack, each with the vulnerability classes beneath it.">
  <section class="wrap head">
    <p class="eyebrow">Failure patterns</p>
    <h1 class="h-lg">Where in the stack<br />it breaks.</h1>
    <p class="lede">Seventeen patterns grouped by layer. Each incident gets exactly one; the <a class="link" href={href('/classes')}>vulnerability classes</a> beneath them are the level a fix works at.</p>
  </section>
  {LAYER_ORDER.map((l) => (
    <section class="wrap section">
      <div class="section-head"><div><h2 class="h-sub">{LAYERS[l].name}</h2><p class="body-sm fog" style="max-width:60ch">{LAYERS[l].blurb}</p></div></div>
      <div class="grid cols-3">
        {categoriesInLayer(l).filter((c) => c !== 'unknown').map((c) => (
          <a class="card card-sm" href={href(`/patterns/${c}`)}>
            <h3 class="h-xs">{CATEGORIES[c].name}</h3>
            <p class="body-sm fog" style="margin:6px 0 16px">{CATEGORIES[c].short}</p>
            <p class="mono caption" style="margin:0">{stat[c].count} incidents · {fmtUsd(stat[c].usd)}</p>
            <p class="caption fog" style="margin:8px 0 0">{classesOf(c).map((x) => CLASSES[x].name).join(' · ')}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  <p class="wrap caption fog" style="margin-top:48px">{stat.unknown.count} incidents remain <a class="link" href={href('/hacks?cat=unknown')}>unclassified</a> because no public source explains the root cause.</p>
</Base>
<style>.head { padding-top: 80px; display: grid; gap: 20px; }</style>
