---
import Base from '../../layouts/Base.astro';
import Bars from '../../components/Bars.astro';
import IncidentTable from '../../components/IncidentTable.astro';
import { categoryStats, yearCategorySeries, fmtUsd, href, classStats, CLASSES } from '../../lib/data';
import { CATEGORIES, CATEGORY_IDS, LAYERS, type CategoryId, type Category } from '../../lib/taxonomy';
import { RUBRIC } from '../../lib/rubric';
import { classesOf } from '../../lib/classes';

export function getStaticPaths() {
  return CATEGORY_IDS.map((id) => ({ params: { id } }));
}
const id = Astro.params.id as CategoryId;
const c: Category = CATEGORIES[id];
const s = categoryStats(id);
const series = yearCategorySeries(id).filter((d) => d.year >= 2016).map((d) => ({ year: d.year, value: d.count }));
const rubric = id === 'unknown' ? undefined : RUBRIC[id];
const classes = classesOf(id).map((x) => classStats.find((k) => k.id === x)!);
---
<Base title={c.name} description={`${c.name}: ${c.short} ${s.count} incidents, ${fmtUsd(s.usd)} lost.`}>
  <section class="wrap head">
    <p class="eyebrow"><a href={href('/patterns')}>Failure patterns</a> / {LAYERS[c.layer].name}</p>
    <h1 class="h-lg">{c.name}</h1>
    <p class="lede">{c.description}</p>
    <div class="grid cols-4 stats">
      <div class="stat-inline"><div class="value">{s.count}</div><div class="label">incidents</div></div>
      <div class="stat-inline"><div class="value">{fmtUsd(s.usd)}</div><div class="label">lost</div></div>
      <div class="stat-inline"><div class="value">{s.first?.year ?? '—'}</div><div class="label">first seen{s.first && ` · ${s.first.name}`}</div></div>
      <div class="stat-inline"><div class="value">{c.owasp?.[0]?.split(':')[0] ?? '—'}</div><div class="label">OWASP Smart Contract Top 10</div></div>
    </div>
  </section>

  {classes.length > 0 && (
    <section class="wrap section">
      <p class="eyebrow" style="margin:0 0 12px">Vulnerability classes</p>
      <div class="grid cols-3">
        {classes.map((k) => (
          <a class="card card-sm" href={href(`/classes/${k.id}`)}>
            <h3 class="h-xs">{CLASSES[k.id].name}</h3>
            <p class="body-sm fog" style="margin:6px 0 12px">{CLASSES[k.id].summary}</p>
            <p class="mono caption" style="margin:0">{k.count} incidents{k.withPoc ? ` · ${k.withPoc} PoCs` : ''}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap section">
    <div class="grid cols-2 split">
      <div class="grid" style="gap:40px">
        {c.anatomy.length > 0 && <div><h2 class="h-xs">How the attack unfolds</h2><ol class="numbered" style="margin-top:12px">{c.anatomy.map((a) => <li>{a}</li>)}</ol></div>}
        {c.prevention.length > 0 && <div><h2 class="h-xs">Prevention</h2><ul class="check" style="margin-top:12px">{c.prevention.map((p) => <li>{p}</li>)}</ul></div>}
        {rubric && (
          <div>
            <h2 class="h-xs">How to tell it apart</h2>
            <p class="body-sm steel" style="margin:8px 0">Not to be confused with: {rubric.not_for}</p>
            <ul class="check">{rubric.examples.map((e) => <li>{e}</li>)}</ul>
          </div>
        )}
      </div>
      <div class="card">
        <p class="body-sm medium" style="margin:0">Incidents per year</p>
        <p class="caption fog" style="margin:0 0 20px">since 2016</p>
        <Bars data={series} height={180} label={`${c.name}: incidents per year`} />
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2 class="h-sub">Largest incidents</h2><a class="btn btn-ghost" href={href(`/hacks?cat=${id}`)}>All {s.count} →</a></div>
    <IncidentTable items={s.biggest} />
  </section>
</Base>
<style>
  .head { padding-top: 80px; display: grid; gap: 20px; }
  .stats { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--color-dove); }
  .split { gap: 48px; align-items: start; }
</style>
