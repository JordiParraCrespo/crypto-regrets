---
import Base from '../../layouts/Base.astro';
import Bars from '../../components/Bars.astro';
import Heatmap from '../../components/Heatmap.astro';
import Switch from '../../components/Switch.astro';
import IncidentTable from '../../components/IncidentTable.astro';
import CosmosResearch from '../../components/CosmosResearch.astro';
import { ecosystem, ECOSYSTEM_IDS, fmtUsd, href, matrix, TREND_COLS, familyOf, CLASSES } from '../../lib/data';
import { CHAIN_FAMILIES } from '../../lib/chains';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { CATEGORIES, CATEGORY_IDS, LAYERS } from '../../lib/taxonomy';

export const getStaticPaths = (() =>
  ECOSYSTEM_IDS.map((id) => ecosystem(id))
    .filter((e) => e.count > 0)
    .map((e) => ({ params: { id: e.id }, props: { e } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { e } = Astro.props as Props;
const id = e.id;
const fam = CHAIN_FAMILIES[id];
const pct = (x: number) => `${Math.round(x * 100)}%`;
const cols = TREND_COLS.filter((c) => c === '≤2015' || Number(c) >= (e.firstYear ?? 2016) || Number(c) >= 2016);
const patternRows = (metric: 'usd' | 'count') => {
  const m = matrix((i) => (familyOf(i) === id && i.category !== 'unknown' ? i.category : null), metric);
  return CATEGORY_IDS.filter((c): c is Exclude<typeof c, 'unknown'> => c !== 'unknown' && m.has(c))
    .map((c) => ({ id: c, label: CATEGORIES[c].name, href: href(`/patterns/${c}`), values: m.get(c)! }))
    .sort((a, b) => [...b.values.values()].reduce((s, v) => s + v, 0) - [...a.values.values()].reduce((s, v) => s + v, 0));
};
const over = e.lift.filter((x) => x.ratio >= 1.3).slice(0, 5);
const under = [...e.lift].filter((x) => x.ratio > 0 && x.ratio <= 0.7).reverse().slice(0, 3);
const maxClass = e.classes[0]?.[1] ?? 1;
const maxChain = e.chains[0]?.[1].usd || 1;
const isCosmos = id === 'cosmos';
---
<Base title={fam.name} description={`${fam.name}: ${e.count} incidents, ${fmtUsd(e.usd)} lost. How security failures evolved, typical vulnerabilities and advisories.`}>
  <section class="wrap page-head">
    <p class="eyebrow"><a href={href('/ecosystems')}>Ecosystems</a> / {fam.name}</p>
    <h1 class="h-lg">{fam.name}</h1>
    <p class="lede">{fam.blurb}.</p>
    {e.chains.length > 1 && <div class="chips">{e.chains.slice(0, 14).map(([c]) => <span class="pill">{c}</span>)}</div>}
    <div class="grid cols-4 stats">
      <div class="stat-inline"><div class="value">{e.count}</div><div class="label">incidents since {e.firstYear}</div></div>
      <div class="stat-inline"><div class="value">{fmtUsd(e.usd)}</div><div class="label">lost · {pct(e.shareOfAll)} of all losses</div></div>
      <div class="stat-inline"><div class="value">{fmtUsd(e.median)}</div><div class="label">median loss per incident</div></div>
      <div class="stat-inline"><div class="value">{e.withPoc}</div><div class="label">with a runnable PoC</div></div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="eyebrow">Over time</p><h2 class="h-md" style="margin-top:8px">Losses and incidents per year</h2></div></div>
    <Switch id="eco-years" labels={['$ lost', 'Incidents']}>
      <div data-panel class="card"><Bars data={e.series('usd')} format="usd" height={220} label={`${fam.name}: amount lost per year`} /></div>
      <div data-panel class="card"><Bars data={e.series('count')} height={220} label={`${fam.name}: incidents per year`} /></div>
    </Switch>
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="eyebrow">What goes wrong here</p><h2 class="h-md" style="margin-top:8px">Typical failures</h2></div></div>
    <div class="grid cols-2 split">
      <div>
        <h3 class="h-xs">Compared with other ecosystems</h3>
        <p class="body-sm fog" style="margin:4px 0 16px">Share of incidents in each pattern here vs everywhere else.</p>
        {over.length ? (
          <ul class="rows">
            {over.map((x) => (
              <li class="lift">
                <a class="medium" href={href(`/patterns/${x.c}`)}>{CATEGORIES[x.c].name}</a>
                <span class="mono caption"><span class="medium">{x.ratio.toFixed(1)}×</span> <span class="fog">{pct(x.shareHere)} here vs {pct(x.shareThere)} elsewhere</span></span>
              </li>
            ))}
          </ul>
        ) : <p class="body-sm fog">No pattern stands out: the mix is close to the overall average.</p>}
        {under.length > 0 && <p class="caption fog" style="margin-top:12px">Rarer than elsewhere: {under.map((x) => `${CATEGORIES[x.c].name.toLowerCase()} (${x.ratio.toFixed(1)}×)`).join(', ')}.</p>}
      </div>
      <div>
        <h3 class="h-xs">Most common vulnerability classes</h3>
        <p class="body-sm fog" style="margin:4px 0 16px">Incidents with enough detail to name a class.</p>
        {e.classes.length ? (
          <ol class="ranked">
            {e.classes.slice(0, 8).map(([c, n]) => (
              <li><a href={href(`/classes/${c}`)}><span class="row"><span class="body-sm medium">{CLASSES[c].name}</span><span class="mono caption fog">{n}</span></span><span class="meter"><span style={`width:${(n / maxClass) * 100}%`}></span></span></a></li>
            ))}
          </ol>
        ) : <p class="body-sm fog">Not enough detail in public sources to name classes yet.</p>}
      </div>
    </div>
    <div style="margin-top:48px">
      <h3 class="h-xs" style="margin-bottom:12px">Where in the stack, here vs overall</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Layer</th><th style="width:38%">{fam.name}</th><th style="width:38%">All ecosystems</th></tr></thead>
          <tbody>
            {e.layerShare.map((x) => (
              <tr>
                <td class="body-sm">{LAYERS[x.l].name}</td>
                <td><span class="bar-cell"><span class="meter"><span style={`width:${x.here * 100}%`}></span></span><span class="mono caption">{pct(x.here)}</span></span></td>
                <td><span class="bar-cell"><span class="meter"><span style={`width:${x.all * 100}%;background:var(--color-pewter)`}></span></span><span class="mono caption fog">{pct(x.all)}</span></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="eyebrow">Patterns over time</p><h2 class="h-md" style="margin-top:8px">What failed, when</h2></div></div>
    <Switch id="eco-patterns" labels={['Incidents', '$ lost']}>
      <div data-panel><Heatmap rows={patternRows('count')} cols={cols} format="count" caption={`Incidents per failure pattern and year in ${fam.name}.`} /></div>
      <div data-panel><Heatmap rows={patternRows('usd')} cols={cols} format="usd" caption={`Amount lost per failure pattern and year in ${fam.name}.`} /></div>
    </Switch>
  </section>

  {e.chains.length > 1 && (
    <section class="wrap section">
      <div class="section-head"><div><p class="eyebrow">Chains</p><h2 class="h-md" style="margin-top:8px">Losses by chain</h2></div></div>
      <ol class="rows">
        {e.chains.slice(0, 12).map(([c, s]) => (
          <li class="chainrow">
            <span class="medium">{c}</span>
            <span class="meter"><span style={`width:${(s.usd / maxChain) * 100}%`}></span></span>
            <span class="mono caption"><span class="medium">{fmtUsd(s.usd)}</span> <span class="fog">· {s.n}</span></span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {isCosmos && <CosmosResearch />}

  {!isCosmos && e.advisories.length > 0 && (
    <section class="wrap section">
      <div class="section-head"><div><p class="eyebrow">Client & library advisories</p><h2 class="h-md" style="margin-top:8px">Below the applications</h2></div><a class="btn btn-ghost" href={href('/infrastructure')}>All advisories →</a></div>
      <ul class="rows">
        {e.advisories.slice(0, 10).map((a) => <li><a class="medium body-sm" href={a.url}>{a.title}</a><div class="mono caption fog">{[a.date ?? '—', a.project, a.cve, a.severity].filter(Boolean).join(' · ')}</div></li>)}
      </ul>
    </section>
  )}

  <section class="wrap section">
    <div class="section-head"><h2 class="h-sub">Largest incidents</h2><a class="btn btn-ghost" href={href('/hacks')}>Full index →</a></div>
    <IncidentTable items={e.biggest} />
  </section>
  <section class="wrap section">
    <h2 class="h-sub" style="margin-bottom:24px">Latest incidents</h2>
    <IncidentTable items={e.latest} />
  </section>
</Base>
<style>
  .lift { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: baseline; }
  .bar-cell { display: grid; grid-template-columns: 1fr 44px; gap: 12px; align-items: center; }
  .bar-cell .mono { text-align: right; }
  .chainrow { display: grid; grid-template-columns: minmax(0, 12rem) 1fr 9rem; gap: 16px; align-items: center; }
  .chainrow .mono { text-align: right; }
  @media (max-width: 640px) { .chainrow { grid-template-columns: 1fr 7rem; } .chainrow .meter { grid-column: 1 / -1; grid-row: 2; } }
</style>
