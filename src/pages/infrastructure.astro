---
import Base from '../layouts/Base.astro';
import IncidentTable from '../components/IncidentTable.astro';
import { advisories, incidents, href } from '../lib/data';
import { ADVISORY_IMPACTS } from '../lib/types';
const infra = incidents.filter((i) => i.category === 'client-bug' || i.category === 'consensus-attack');
const sorted = [...advisories].sort((a, b) => (b.date ?? '0').localeCompare(a.date ?? '0'));
const projects = [...new Set(advisories.map((a) => a.project))].sort((a, b) => advisories.filter((x) => x.project === b).length - advisories.filter((x) => x.project === a).length);
const LABEL: Record<string, string> = { 'consensus-split': 'Consensus split', inflation: 'Inflation', 'remote-crash': 'Remote crash', dos: 'Denial of service', 'chain-halt': 'Chain halt', rce: 'Remote code execution', censorship: 'Censorship', other: 'Other' };
const byImpact = ADVISORY_IMPACTS.map((im) => ({ im, n: advisories.filter((a) => a.impact === im).length })).filter((x) => x.n > 0);
---
<Base title="Infrastructure" description="Consensus failures, 51% attacks, node crashes, chain halts and compiler bugs below the application layer.">
  <section class="wrap head">
    <p class="eyebrow">Infrastructure</p>
    <h1 class="h-lg">Below the contracts.</h1>
    <p class="lede">Base layers, clients and compilers break too: value-overflow bugs, chain splits between versions, 51% attacks on small proof-of-work chains, P2P messages that crash nodes, and compiler bugs like the Vyper reentrancy-lock flaw behind the 2023 Curve exploits.</p>
  </section>

  <section class="wrap section">
    <div class="section-head"><h2 class="h-sub">Base-layer incidents</h2></div>
    <IncidentTable items={infra} />
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div><h2 class="h-sub">Disclosed vulnerabilities</h2><p class="body-sm fog">{advisories.length} advisories across {projects.length} projects. Impact is our keyword classification of each title.</p></div>
    </div>
    <div class="chips" style="margin-bottom:24px">{byImpact.map((x) => <span class="pill">{LABEL[x.im]} <span class="fog">{x.n}</span></span>)}</div>
    <form class="filters" onsubmit="return false"><select class="select" id="proj" aria-label="Project"><option value="">All projects</option>{projects.map((p) => <option value={p} data-count={advisories.filter((a) => a.project === p).length}>{p}</option>)}</select></form>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Disclosed</th><th>Project</th><th>Advisory</th><th class="hide-sm">Impact</th><th class="hide-sm">Severity</th></tr></thead>
        <tbody id="adv">
          {sorted.map((a) => (
            <tr data-p={a.project}>
              <td class="mono caption fog" style="white-space:nowrap">{a.date ?? '—'}</td>
              <td class="caption">{a.project}</td>
              <td><a class="medium" href={a.url}>{a.title}</a><div class="mono caption fog">{a.cve}</div></td>
              <td class="caption hide-sm">{LABEL[a.impact]}</td>
              <td class="caption hide-sm">{a.severity ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="caption fog" style="margin-top:16px">Sources: Bitcoin Core security advisories, Geth disclosures, the Cosmos ASA list, and OSV / GitHub Security Advisories. <a class="link" href={href('/classes/node-dos-halt')}>Node DoS class →</a></p>
  </section>
  <script>
    const sel = document.getElementById('proj') as HTMLSelectElement;
    sel.addEventListener('input', () => {
      for (const r of document.querySelectorAll<HTMLTableRowElement>('#adv tr')) r.hidden = !!sel.value && r.dataset.p !== sel.value;
    });
  </script>
  <script>
    import '../scripts/combobox';
  </script>
</Base>
<style>
  .head { padding-top: 80px; display: grid; gap: 20px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .filters { margin-bottom: 8px; }
</style>
