---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import { incidents, advisories, href, YEARS, classified, CLASSES } from '../lib/data';
const REPO = 'https://github.com/JordiParraCrespo/crypto-regrets';
const example = incidents.find((i) => i.poc && i.vulnClass && i.txHashes.length && i.descriptions.length > 1) ?? incidents[0];
const exampleJson = JSON.stringify(
  { ...example, descriptions: example.descriptions.slice(0, 2), references: example.references.slice(0, 2) },
  null,
  2,
);
const dataset = {
  '@type': 'Dataset',
  name: 'Crypto Regrets: classified crypto security incidents',
  description: `${incidents.length.toLocaleString('en')} crypto hacks and exploits from ${YEARS[0]} to ${YEARS[YEARS.length - 1]}, merged from ten public sources and deduplicated, each with a failure pattern, a vulnerability class where the evidence allows, loss in USD, chains, sources, attack transactions and Foundry PoC links.`,
  url: new URL(href('/data'), Astro.site).toString(),
  keywords: ['crypto hacks', 'smart contract vulnerabilities', 'DeFi exploits', 'blockchain security', 'vulnerability classification'],
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: 'Crypto Regrets', url: new URL(href('/'), Astro.site).toString() },
  temporalCoverage: `${YEARS[0]}/${YEARS[YEARS.length - 1]}`,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL(href('/api/incidents.json'), Astro.site).toString() },
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: new URL(href('/data/incidents.csv'), Astro.site).toString() },
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL(href('/api/vulnerability-classes.json'), Astro.site).toString() },
  ],
};
const usage = `# every reentrancy incident with a runnable exploit
curl -s ${'$SITE'}/api/vulnerability-classes.json \\
  | jq '.[] | select(.category=="reentrancy") | .cases[] | select(.poc) | {name, poc}'`;
---
<Base title="Data" description="Download every indexed crypto incident and the vulnerability-class dataset as JSON or CSV." jsonLd={[dataset]}>
  <section class="wrap page-head">
    <p class="eyebrow">Data</p>
    <h1 class="h-lg">Every incident is a file.</h1>
    <p class="lede">The whole index lives in the repository's <a class="link" href={`${REPO}/tree/main/data`}><code>data/</code></a> directory. Download it, diff it, build on it, or correct an incident with a pull request.</p>
  </section>

  <section class="wrap section">
    <div class="grid cols-2">
      <div class="card">
        <p class="eyebrow" style="margin:0">For tool builders</p>
        <h2 class="h-sm" style="margin:8px 0 12px">vulnerability-classes.json</h2>
        <p class="body-sm steel" style="margin:0 0 20px">{Object.keys(CLASSES).length} classes, each with CWE/SWC ids, vulnerable and fixed code, detection signals and remediation, plus the {classified.toLocaleString('en')} real incidents labelled with it. Cases with PoCs and attack transactions come first, ready to use as test cases.</p>
        <a class="btn btn-primary" href={href('/api/vulnerability-classes.json')}>Download JSON</a>
      </div>
      <div class="card">
        <p class="eyebrow" style="margin:0">Everything</p>
        <h2 class="h-sm" style="margin:8px 0 12px">incidents.json · incidents.csv</h2>
        <p class="body-sm steel" style="margin:0 0 20px">All {incidents.length.toLocaleString('en')} incidents with pattern, class, every source's description, tx hashes, PoC links, references and the model's second opinion. The CSV has the main fields for spreadsheets.</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <a class="btn btn-compact" href={href('/api/incidents.json')}>JSON</a>
          <a class="btn btn-compact" href={href('/data/incidents.csv')}>CSV</a>
          <a class="btn btn-compact" href={href('/api/advisories.json')}>Advisories ({advisories.length})</a>
          <a class="btn btn-compact" href={href('/api/taxonomy.json')}>Taxonomy</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid cols-2 split">
      <div>
        <h2 class="h-sub">Repository layout</h2>
        <ul class="rows" style="margin-top:20px">
          <li class="f"><code>data/incidents.json</code><span class="body-sm fog">every incident, one per line</span></li>
          <li class="f"><code>data/incidents/&lt;year&gt;/&lt;id&gt;.json</code><span class="body-sm fog">one file per incident</span></li>
          <li class="f"><code>data/vulnerability-classes.json</code><span class="body-sm fog">class knowledge + labelled cases</span></li>
          <li class="f"><code>data/incidents.csv</code><span class="body-sm fog">flat export</span></li>
          <li class="f"><code>data/advisories.json</code><span class="body-sm fog">client, SDK and compiler advisories</span></li>
          <li class="f"><code>data/typesafe/</code><span class="body-sm fog">cached model answers and evaluations</span></li>
          <li class="f"><code>data/raw/</code><span class="body-sm fog">source snapshots the index is built from</span></li>
        </ul>
        <p class="caption fog" style="margin-top:16px">Files per year: {YEARS.slice().reverse().map((y) => `${y} ${incidents.filter((i) => i.year === y).length}`).join(' · ')}</p>
      </div>
      <div>
        <h2 class="h-sub">Query it</h2>
        <Terminal title="zsh" code={usage} style="margin-top:20px" />
        <p class="body-sm fog" style="margin-top:16px">Schemas are defined once with zod in <a class="link" href={`${REPO}/blob/main/src/lib/types.ts`}><code>src/lib/types.ts</code></a> and validated on every build, so <code>category</code> and <code>vulnClass</code> are always valid ids.</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="h-sub">Example record</h2>
    <p class="caption fog" style="margin:4px 0 20px"><a class="link" href={`${REPO}/blob/main/data/incidents/${example.year}/${example.id}.json`}>data/incidents/{example.year}/{example.id}.json</a> (lists shortened)</p>
    <Terminal title={`${example.id}.json`} code={exampleJson} />
  </section>
</Base>
<style>
  .f { display: grid; gap: 4px; }
  .f code { justify-self: start; }
  :global(.terminal pre) { max-height: 520px; }
</style>
