---
import Base from '../layouts/Base.astro';
import Bars from '../components/Bars.astro';
import { eraStats, fmtUsd, fmtDate, href, yearSeries, incidents, CLASSES } from '../lib/data';
import { CATEGORIES } from '../lib/taxonomy';
import type { ClassId } from '../lib/classes';
const eras = eraStats();
const counts = yearSeries('count');
const losses = yearSeries('usd');
const topClasses = (from: number, to: number) => {
  const m = new Map<ClassId, number>();
  for (const i of incidents) if (i.vulnClass && i.year >= from && i.year <= to) m.set(i.vulnClass, (m.get(i.vulnClass) ?? 0) + 1);
  return [...m].sort((a, b) => b[1] - a[1]).slice(0, 4);
};
---
<Base title="History" description="How crypto security failures evolved from the 2010 Bitcoin overflow to today, era by era.">
  <section class="wrap head">
    <p class="eyebrow">History</p>
    <h1 class="h-lg">Sixteen years of<br />expensive lessons.</h1>
    <p class="lede">Each era had its own way of losing money. Attackers follow the money: from exchange servers to contracts, to economic design, to bridges, and back to people and keys.</p>
  </section>

  <section class="wrap section">
    <div class="grid cols-2">
      <div class="card"><p class="body-sm medium" style="margin:0">Incidents per year</p><p class="caption fog" style="margin:0 0 20px">all sources, deduplicated</p><Bars data={counts} height={160} label="Incidents per year" /></div>
      <div class="card"><p class="body-sm medium" style="margin:0">Losses per year</p><p class="caption fog" style="margin:0 0 20px">nominal USD at time of incident</p><Bars data={losses} format="usd" height={160} label="Losses per year" /></div>
    </div>
  </section>

  {eras.map((e) => {
    const tc = topClasses(e.from, e.to);
    return (
      <section class="wrap section era" id={e.id}>
        <div class="grid era-grid">
          <div>
            <p class="mono caption fog" style="margin:0">{e.from === e.to ? e.from : `${e.from}–${e.to}`}</p>
            <h2 class="h-md" style="margin:8px 0 16px">{e.name}</h2>
            <p class="steel" style="margin:0 0 24px;max-width:56ch">{e.summary}</p>
            <div class="grid cols-2" style="gap:16px">
              <div class="stat-inline"><div class="value">{e.count.toLocaleString('en')}</div><div class="label">incidents</div></div>
              <div class="stat-inline"><div class="value">{fmtUsd(e.usd)}</div><div class="label">lost</div></div>
            </div>
            <p class="eyebrow" style="margin:32px 0 8px">Costliest patterns</p>
            <div class="chips">{e.topByUsd.map((c) => <a class="pill" href={href(`/patterns/${c.id}`)}>{CATEGORIES[c.id].name} <span class="fog">{fmtUsd(c.usd)}</span></a>)}</div>
            {tc.length > 0 && (
              <>
                <p class="eyebrow" style="margin:20px 0 8px">Most frequent vulnerabilities</p>
                <div class="chips">{tc.map(([id, n]) => <a class="pill pill-mono" href={href(`/classes/${id}`)}>{CLASSES[id].name} <span class="fog">{n}</span></a>)}</div>
              </>
            )}
          </div>
          <div class="card card-sm">
            <p class="eyebrow" style="margin:0 0 4px">Defining incidents</p>
            <ul class="rows">
              {e.notable.map((i) => (
                <li class="inc">
                  <a class="medium" href={href(`/hacks/${i.id}`)}>{i.name}</a>
                  <span class="mono caption fog">{fmtDate(i.date)} · {fmtUsd(i.amountUsd)}</span>
                  <span class="caption steel">{i.vulnClass ? CLASSES[i.vulnClass].name : CATEGORIES[i.category].name}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    );
  })}
</Base>
<style>
  .head { padding-top: 80px; display: grid; gap: 20px; }
  .era { padding-top: 48px; border-top: 1px solid var(--color-dove); }
  .era-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 960px) { .era-grid { grid-template-columns: minmax(0, 1fr); } }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .inc { display: grid; gap: 2px; }
  .card .rows > li:last-child { border-bottom: 0; }
</style>
