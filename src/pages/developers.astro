---
import Base from '../layouts/Base.astro';
import { classStats, fmtUsd, href, incidents, CLASSES } from '../lib/data';
import { CATEGORIES } from '../lib/taxonomy';
const ranked = classStats.filter((s) => s.count > 0).sort((a, b) => b.count - a.count);
const code = ranked.filter((s) => CLASSES[s.id].vulnerable?.lang === 'solidity');
const ops = ranked.filter((s) => CLASSES[s.id].vulnerable?.lang !== 'solidity');
const withAudit = incidents.filter((i) => i.audit);
const unaudited = withAudit.filter((i) => /unaudited/i.test(i.audit!)).length;
const oos = withAudit.filter((i) => /out of scope/i.test(i.audit!)).length;
const audited = withAudit.length - unaudited - oos;
---
<Base title="Secure-coding checklist" description="A secure-development checklist built from every crypto hack, ranked by how often each vulnerability class occurs.">
  <section class="wrap page-head">
    <p class="eyebrow">For developers</p>
    <h1 class="h-lg">The checklist written<br />by attackers.</h1>
    <p class="lede">Every item below is a vulnerability class that has drained real money, ordered by how often it happens. Work from the top.</p>
  </section>

  <section class="wrap section">
    <div class="card wash">
      <p class="eyebrow" style="margin:0">Audits help, but they aren't enough</p>
      <p class="h-sm" style="margin:12px 0 0;max-width:40ch">Of the {withAudit.length} incidents where REKT recorded audit status, {unaudited} were unaudited, {audited} had been audited, and {oos} were hacked in code outside the audit's scope.</p>
    </div>
  </section>

  {[
    { eyebrow: 'In your code', title: 'Smart-contract classes', items: code },
    { eyebrow: 'Around your code', title: 'Keys, people, infrastructure', items: ops },
  ].map(({ eyebrow, title, items }) => (
    <section class="wrap section">
      <div class="section-head"><div><p class="eyebrow">{eyebrow}</p><h2 class="h-md" style="margin-top:8px">{title}</h2></div></div>
      <ol class="rows list">
        {items.map((s, k) => (
          <li>
            <span class="mono caption fog idx">{String(k + 1).padStart(2, '0')}</span>
            <div>
              <a class="h-xs" href={href(`/classes/${s.id}`)}>{CLASSES[s.id].name}</a>
              <p class="body-sm fog" style="margin:2px 0 8px">{s.count} incidents · {fmtUsd(s.usd)} · {CATEGORIES[CLASSES[s.id].parent].name}</p>
              <ul class="check">{CLASSES[s.id].fix.map((f) => <li>{f}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="wrap section">
    <div class="card">
      <p class="eyebrow" style="margin:0">Learning path</p>
      <h2 class="h-sm" style="margin:8px 0 20px">For security researchers</h2>
      <ol class="numbered">
        <li>Read the <a class="link" href="https://scs.owasp.org/sctop10/">OWASP Smart Contract Top 10</a> for the vocabulary.</li>
        <li>For each class above, read three incidents, then run their DeFiHackLabs PoCs with <code>forge test -vvvv</code> and trace the calls.</li>
        <li>Find the same class in audit reports on <a class="link" href="https://solodit.cyfrin.io/">Solodit</a>: bugs show up in audits before they show up as hacks.</li>
        <li>Practice with Ethernaut, Damn Vulnerable DeFi and the <a class="link" href="https://github.com/immunefi-team/Web3-Security-Library">Immunefi Web3 Security Library</a>.</li>
        <li>Follow new incidents on <a class="link" href="https://rekt.news/">REKT</a> and <a class="link" href="https://github.com/security-alliance/seal-911">SEAL 911</a>.</li>
      </ol>
    </div>
  </section>
</Base>
<style>
  .list > li { display: grid; grid-template-columns: 48px 1fr; gap: 8px; padding: 24px 0; }
  .idx { padding-top: 4px; }
  .list a.h-xs:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
