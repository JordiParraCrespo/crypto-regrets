---
import Base from '../../layouts/Base.astro';
import CategoryChip from '../../components/CategoryChip.astro';
import IncidentTable from '../../components/IncidentTable.astro';
import { incidents, fmtUsd, fmtDate, href } from '../../lib/data';
import { CATEGORIES, LAYERS, ERAS, eraForYear } from '../../lib/taxonomy';
import type { Incident, SourceId } from '../../lib/types';

export function getStaticPaths() {
  return incidents.map((i) => ({ params: { id: i.id }, props: { i } }));
}
const { i } = Astro.props as { i: Incident };
const c = CATEGORIES[i.category];
const era = ERAS.find((e) => e.id === eraForYear(i.year))!;
const similar = incidents.filter((x) => x.category === i.category && x.id !== i.id).sort((a, b) => Math.abs(a.year - i.year) - Math.abs(b.year - i.year) || (b.amountUsd ?? 0) - (a.amountUsd ?? 0)).slice(0, 6);
const SOURCE_NAMES = { defillama: 'DefiLlama', defihacklabs: 'DeFiHackLabs', rekt: 'REKT', slowmist: 'SlowMist', blocksec: 'BlockSec', revertiq: 'RevertIQ', curated: 'Curated' } as const satisfies Record<SourceId, string>;
const CLASSIFIED_BY = { defillama: 'DefiLlama label', keywords: 'Keyword rules', typesafe: 'TypeSafe (Jev)', curated: 'Curated post-mortem', none: 'Unclassified' } as const;
const ai = i.ai;
const aiAgrees = ai?.category === i.category;
const pct = (p: number) => `${Math.round(p * 100)}%`;
---
<Base title={i.name} description={`${i.name} (${i.date}): ${c.name}. ${i.rootCause ?? c.short}`}>
  <p class="small"><a href={href('/hacks')}>← All hacks</a></p>
  <h1>{i.name}</h1>
  <p class="meta"><span class="mono">{fmtDate(i.date)}</span> · <strong>{fmtUsd(i.amountUsd)}</strong> lost{i.returnedUsd ? ` · ${fmtUsd(i.returnedUsd)} returned/recovered (per DefiLlama)` : ''} · <CategoryChip id={i.category} /></p>

  <div class="grid grid-2">
    <div class="card">
      <h3>Root cause</h3>
      {i.rootCause ? <p>{i.rootCause}</p> : <p class="muted">No technical write-up in our sources yet. Pattern summary: {c.short}</p>}
      {i.technique && <p class="small"><strong>Technique:</strong> {i.technique}</p>}
      {i.classificationNote && <p class="small muted"><strong>Classification note:</strong> {i.classificationNote}</p>}
      {i.poc && <p><a class="btn" href={i.poc}>View Foundry PoC on DeFiHackLabs ↗</a></p>}
    </div>
    <div class="card">
      <h3>Details</h3>
      <dl>
        <dt>Pattern</dt><dd><a href={href(`/patterns/${i.category}`)}>{c.name}</a></dd>
        <dt>Layer</dt><dd>{LAYERS[c.layer].name}</dd>
        <dt>Era</dt><dd><a href={href(`/history#${era.id}`)}>{era.name}</a></dd>
        {i.chains.length > 0 && <><dt>Chains</dt><dd>{i.chains.join(', ')}</dd></>}
        {i.targetType && <><dt>Target</dt><dd>{i.targetType}</dd></>}
        {i.language && <><dt>Language</dt><dd>{i.language}</dd></>}
        {i.audit && <><dt>Audit (per REKT)</dt><dd>{i.audit}</dd></>}
        <dt>Bridge</dt><dd>{i.bridge ? 'Yes' : 'No'}</dd>
        <dt>Sources</dt><dd>{i.sources.map((s) => SOURCE_NAMES[s]).join(', ')}</dd>
        <dt>Classified by</dt><dd>{CLASSIFIED_BY[i.classifiedBy]}</dd>
      </dl>
    </div>
  </div>

  {ai && (
    <section class="card ai">
      <h3>Model second opinion <span class="muted small">· TypeSafe {ai.model}</span></h3>
      <p class="small">
        {aiAgrees ? <>Agrees with the assigned pattern</> : <>Suggests <a href={href(`/patterns/${ai.category}`)}>{CATEGORIES[ai.category].name}</a> instead</>}
        {' '}with confidence <strong>{ai.confidence.toFixed(2)}</strong>.
        {!aiAgrees && i.classifiedBy !== 'typesafe' && <span class="muted"> We keep the {CLASSIFIED_BY[i.classifiedBy].toLowerCase()}; disagreements are worth a look.</span>}
      </p>
      <ul class="clean probs">
        {ai.top.map((t) => (
          <li><span class="plabel">{CATEGORIES[t.category].name}</span><span class="ptrack"><span class="pfill" style={`width:${t.p * 100}%`} /></span><span class="mono small">{pct(t.p)}</span></li>
        ))}
      </ul>
      {ai.hasRootCause < 0.5 && <p class="small muted">The model judged that the available descriptions don't explain how the attack worked ({pct(ai.hasRootCause)}), so its answer is a weak guess.</p>}
      <p class="small muted" style="margin-bottom:0">From the write-up: flash loan used <strong>{pct(ai.flashLoan)}</strong> · attributed to a state actor <strong>{pct(ai.stateActor)}</strong>. These are model probabilities from the text above, not verified facts.</p>
    </section>
  )}

  {c.prevention.length > 0 && (
    <section>
      <h2>How to prevent this class of bug</h2>
      <ul>{c.prevention.map((p) => <li>{p}</li>)}</ul>
      <p class="small"><a href={href(`/patterns/${i.category}`)}>Full pattern guide: {c.name} →</a></p>
    </section>
  )}

  {i.descriptions.length > 1 && (
    <>
      <h2>What each source says</h2>
      <div class="grid grid-2">
        {i.descriptions.map((d) => <div class="card"><p class="small muted" style="margin-top:0"><strong>{d.source}</strong></p><p class="small" style="margin-bottom:0">{d.text}</p></div>)}
      </div>
    </>
  )}

  {i.txHashes.length > 0 && (
    <>
      <h2>Attack transactions</h2>
      <ul class="mono small">{i.txHashes.slice(0, 8).map((h) => <li style="overflow-wrap:anywhere">{h}</li>)}</ul>
    </>
  )}

  <h2>References</h2>
  <ul>{i.references.map((r) => <li><a href={r.url} rel="noopener nofollow">{r.label}</a> <span class="muted small">({SOURCE_NAMES[r.source]})</span></li>)}</ul>

  {similar.length > 0 && <><h2>Similar incidents</h2><IncidentTable items={similar} /></>}
</Base>
<style>
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--text-2); }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; font-size: 0.92rem; }
  dt { color: var(--muted); }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .ai { margin-top: 16px; }
  .probs li { display: grid; grid-template-columns: minmax(0, 14rem) 1fr 3rem; gap: 10px; align-items: center; border: 0; padding: 3px 0; }
  .plabel { font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ptrack { height: 8px; background: var(--surface-2); border-radius: 4px; overflow: hidden; }
  .pfill { display: block; height: 100%; background: var(--s1); border-radius: 0 4px 4px 0; }
  .probs .mono { text-align: right; }
  .btn { display: inline-block; border: 1px solid var(--border); padding: 6px 12px; border-radius: 8px; background: var(--surface-2); }
</style>
