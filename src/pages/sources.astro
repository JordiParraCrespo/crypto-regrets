---
import Base from '../layouts/Base.astro';
import evaluation from '../../data/typesafe/evaluation.json';
import { sourceAudit, incidents, href, fmtUsd, SOURCE_NAMES, CLASSES } from '../lib/data';
import { CATEGORIES } from '../lib/taxonomy';
import type { SourceId } from '../lib/types';

const count = (s: SourceId) => incidents.filter((i) => i.sources.includes(s)).length;
const withAi = incidents.filter((i) => i.ai);
const llama = withAi.filter((i) => i.classifiedBy === 'defillama');
const llamaAgree = llama.filter((i) => i.ai!.category === i.category).length;
const llamaConf = llama.filter((i) => i.ai!.confidence >= 0.7);
const llamaConfAgree = llamaConf.filter((i) => i.ai!.category === i.category).length;
const byTs = incidents.filter((i) => i.classifiedBy === 'typesafe').length;
const classBy = (b: string) => incidents.filter((i) => i.vulnClassBy === b).length;
const disagreements = withAi
  .filter((i) => i.ai!.category !== i.category && i.ai!.confidence >= 0.9 && i.ai!.category !== 'unknown')
  .sort((a, b) => (b.amountUsd ?? 0) - (a.amountUsd ?? 0));
const model = withAi[0]?.ai?.model ?? 'jev';
const pct = (x: number) => `${(x * 100).toFixed(1)}%`;
const groups = [...new Set(sourceAudit.map((s) => s.category))];
const NAMES: Record<string, string> = {
  'exploit-database': 'Hack & exploit databases',
  'vulnerability-dataset': 'Vulnerability datasets',
  'protocol-advisories': 'Client, consensus & protocol advisories',
  'taxonomy-research': 'Taxonomies & research',
};
const merged: { id: SourceId; url: string; role: string }[] = [
  { id: 'defillama', url: 'https://defillama.com/hacks', role: 'Backbone: date, amount, chain, target, analyst labels' },
  { id: 'defihacklabs', url: 'https://github.com/SunWeb3Sec/DeFiHackLabs', role: 'Technical root causes, Foundry PoCs, attack transactions' },
  { id: 'rekt', url: 'https://rekt.news/', role: 'Post-mortem articles and audit status' },
  { id: 'slowmist', url: 'https://hacked.slowmist.io/en/', role: 'Events since 2012 incl. exchanges and 51% attacks (frauds excluded)' },
  { id: 'blocksec', url: 'https://blocksec.com/security-incident', role: 'Attack transactions and root-cause labels' },
  { id: 'revertiq', url: 'https://revertiq.ai/hacks', role: 'Summaries and source citations (machine-written)' },
  { id: 'graveyard', url: 'https://magoo.github.io/Blockchain-Graveyard/', role: 'Early exchange breaches, 2011–2021' },
  { id: 'seal911', url: 'https://github.com/security-alliance/seal-911', role: 'Incident response log (names and dates)' },
  { id: 'w3igg', url: 'https://www.web3isgoinggreat.com/', role: 'Enrichment only: descriptions for incidents already indexed' },
  { id: 'curated', url: href('/sources'), role: 'Hand-written post-mortems for landmark and base-layer incidents' },
];
---
<Base title="Method & sources" description="How the index is built and classified, how the classifier was evaluated, and an audit of 30 blockchain-security sources.">
  <section class="wrap head">
    <p class="eyebrow">Method</p>
    <h1 class="h-lg">How it's built,<br />and how far to trust it.</h1>
    <p class="lede">Ten sources merged and deduplicated, two levels of classification, and every model decision measured against human labels before it was allowed to set a label.</p>
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="eyebrow">1 · Sources</p><h2 class="h-md" style="margin-top:8px">Merged into one record per incident</h2></div></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Source</th><th>Role</th><th class="num">Incidents</th></tr></thead>
        <tbody>{merged.map((m) => <tr><td><a class="medium" href={m.url}>{SOURCE_NAMES[m.id]}</a></td><td class="body-sm steel">{m.role}</td><td class="num">{count(m.id)}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="body-sm fog" style="margin-top:16px;max-width:80ch">Records are joined by a CamelCase-aware name key and a date window (±7 days, ±10 for REKT), with a strict same-name fallback within 2 days and a headline matcher for news sources. Third-party text is quoted briefly (≤ 700 characters) with a link back; DeFiHackLabs text is Apache-2.0. SlowMist entries labelled Scam or Ponzi are excluded: frauds, not security failures.</p>
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="eyebrow">2 · Classification</p><h2 class="h-md" style="margin-top:8px">Two levels, evidence first</h2></div></div>
    <div class="grid cols-2">
      <div class="card">
        <h3 class="h-xs">Pattern (17)</h3>
        <ol class="numbered" style="margin-top:16px">
          <li>Curated post-mortem, if any</li>
          <li>DefiLlama analyst label, mapped to our taxonomy with documented overrides</li>
          <li>TypeSafe {model}, if confidence ≥ 0.7 and the text explains the attack ({byTs} incidents)</li>
          <li>Keyword rules as a last resort</li>
        </ol>
      </div>
      <div class="card">
        <h3 class="h-xs">Vulnerability class ({Object.keys(CLASSES).length})</h3>
        <ol class="numbered" style="margin-top:16px">
          <li>Curated post-mortem ({classBy('curated')})</li>
          <li>Analyst technique label that names exactly one class ({classBy('technique')})</li>
          <li>TypeSafe, choosing only among the pattern's classes, at ≥ 0.9 confidence ({classBy('typesafe')})</li>
          <li>Otherwise <em>unspecified</em>: we don't guess</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="eyebrow">3 · Evaluation</p><h2 class="h-md" style="margin-top:8px">Measured, not assumed</h2><p class="lede">Every design choice was tested against human labels. Variants were asked in the same request, so they saw identical input.</p></div></div>
    <div class="grid cols-2">
      <div>
        <h3 class="h-xs">Pattern level · {evaluation.pattern.testSet} incidents</h3>
        <table style="margin-top:12px">
          <thead><tr><th>Question design</th><th class="num">Exact</th><th class="num">Layer</th></tr></thead>
          <tbody>{evaluation.pattern.variants.map((v) => <tr><td class="body-sm">{v.name}</td><td class="num">{pct(v.exact)}</td><td class="num">{pct(v.layer)}</td></tr>)}</tbody>
        </table>
        <table style="margin-top:24px">
          <thead><tr><th>Model confidence</th><th class="num">TypeSafe</th><th class="num">Keyword rules</th></tr></thead>
          <tbody>{evaluation.pattern.byConfidence.map((b) => <tr><td class="mono caption">{b.band}</td><td class="num">{pct(b.typesafe)}</td><td class="num">{pct(b.keywords)}</td></tr>)}</tbody>
        </table>
      </div>
      <div>
        <h3 class="h-xs">Class level · {evaluation.class.testSet} incidents, analyst label hidden</h3>
        <table style="margin-top:12px">
          <thead><tr><th>Model confidence</th><th class="num">Correct</th><th class="num">Share</th></tr></thead>
          <tbody>{evaluation.class.blindByConfidence.map((b) => <tr><td class="mono caption">{b.band}</td><td class="num">{pct(b.accuracy)}</td><td class="num">{pct(b.share)}</td></tr>)}</tbody>
        </table>
        <ul class="check" style="margin-top:24px">
          <li>Sending every source's description instead of the single best one cost {Math.abs(evaluation.pattern.allDescriptionsPenalty * 100)} points.</li>
          <li>Claude Haiku scored {pct(evaluation.pattern.haiku.exact)} vs TypeSafe {pct(evaluation.pattern.haiku.typesafe)}; when they disagreed TypeSafe was right {evaluation.pattern.haiku.onDisagreement.typesafe} times, Haiku {evaluation.pattern.haiku.onDisagreement.haiku}. Not used.</li>
          <li>Agreement with DefiLlama's labels across all {llama.length} incidents: {pct(llamaAgree / llama.length)}; where the model is ≥ 0.7 confident: {pct(llamaConfAgree / Math.max(llamaConf.length, 1))}.</li>
        </ul>
      </div>
    </div>
    {disagreements.length > 0 && (
      <details style="margin-top:32px">
        <summary class="body-sm medium" style="cursor:pointer">{disagreements.length} confident disagreements with human labels, worth reviewing</summary>
        <div class="table-wrap" style="margin-top:12px">
          <table>
            <thead><tr><th>Incident</th><th>Assigned</th><th>Model says</th><th class="num">Conf.</th><th class="num">Lost</th></tr></thead>
            <tbody>{disagreements.map((i) => <tr><td><a class="medium" href={href(`/hacks/${i.id}`)}>{i.name}</a></td><td class="caption">{CATEGORIES[i.category].name}</td><td class="caption">{CATEGORIES[i.ai!.category].name}</td><td class="num">{i.ai!.confidence.toFixed(2)}</td><td class="num">{fmtUsd(i.amountUsd)}</td></tr>)}</tbody>
          </table>
        </div>
      </details>
    )}
  </section>

  <section class="wrap section">
    <div class="section-head"><div><p class="eyebrow">4 · Source audit</p><h2 class="h-md" style="margin-top:8px">30 sources evaluated</h2><p class="lede">What each covers, whether it is machine-readable, and its caveats.</p></div></div>
    {groups.map((g) => (
      <div style="margin-bottom:40px">
        <h3 class="h-xs" style="margin-bottom:8px">{NAMES[g] ?? g}</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Source</th><th>Status</th><th class="hide-sm">Machine-readable</th><th class="hide-sm">Concerns</th></tr></thead>
            <tbody>
              {sourceAudit.filter((s) => s.category === g).map((s) => (
                <tr>
                  <td style="min-width:200px"><a class="medium" href={s.url}>{s.name}</a><div class="caption fog">{s.coverage}</div></td>
                  <td><span class:list={['pill', s.status === 'offline' ? 'pill-outline' : '']}>{s.status}</span></td>
                  <td class="mono caption hide-sm" style="overflow-wrap:anywhere;max-width:340px">{s.machineReadable}</td>
                  <td class="caption steel hide-sm" style="max-width:340px">{s.concerns}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </section>
</Base>
<style>.head { padding-top: 80px; display: grid; gap: 20px; }</style>
