---
import type { Incident } from '../lib/types';
import { href, fmtUsd, fmtDate } from '../lib/data';
import { CLASSES } from '../lib/classes';
import { CATEGORIES } from '../lib/taxonomy';
interface Props { items: Incident[]; showClass?: boolean }
const { items, showClass = true } = Astro.props;
---
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Date</th><th>Incident</th>{showClass && <th class="hide-sm">Vulnerability</th>}<th class="num">Lost</th></tr>
    </thead>
    <tbody>
      {items.map((i) => (
        <tr>
          <td class="mono caption fog" style="white-space:nowrap">{fmtDate(i.date)}</td>
          <td>
            <a class="medium" href={href(`/hacks/${i.id}`)}>{i.name}</a>
            {i.poc && <span class="pill pill-sand pill-mono" style="margin-left:8px;padding:0 8px">PoC</span>}
            <div class="caption fog">{i.chains.slice(0, 3).join(' · ')}</div>
          </td>
          {showClass && <td class="caption hide-sm">{i.vulnClass ? CLASSES[i.vulnClass].name : <span class="fog">{CATEGORIES[i.category].name}</span>}</td>}
          <td class="num">{fmtUsd(i.amountUsd)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
