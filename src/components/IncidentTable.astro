---
import type { Incident } from '../lib/types';
import IncidentRow from './IncidentRow.astro';
interface Props { items: Incident[]; showClass?: boolean }
const { items, showClass = true } = Astro.props;
---
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Date</th><th>Incident</th>{showClass && <th class="hide-sm">Vulnerability</th>}<th class="num">Lost</th></tr>
    </thead>
    <tbody>
      {items.map((i) => <IncidentRow i={i} showClass={showClass} />)}
    </tbody>
  </table>
</div>
