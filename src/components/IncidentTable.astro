---
import type { Incident } from '../lib/types';
import IncidentRow from './IncidentRow.astro';
interface Props { items: Incident[] }
const { items } = Astro.props;
---
<div class="table-wrap">
  <table>
    <thead><tr><th>Date</th><th>Incident</th><th>Pattern</th><th>Chain</th><th class="num">Lost</th></tr></thead>
    <tbody>{items.map((i) => <IncidentRow i={i} />)}</tbody>
  </table>
</div>
