---
/**
 * Stacked bar chart: one bar per year, segments per layer (fixed categorical slot order).
 * Hover: native SVG <title> on each segment + full-bar hit target. Table view in <details>.
 */
import { LAYERS, type LayerId } from '../lib/taxonomy';
import { LAYER_ORDER, layerSlot, fmtUsd } from '../lib/data';
interface Props {
  data: { year: number; row: Record<LayerId, number> }[];
  metric: 'count' | 'usd';
  title: string;
  caption?: string;
}
const { data, metric, title, caption } = Astro.props;
const fmt = (v: number) => (metric === 'usd' ? fmtUsd(v) : v.toLocaleString('en'));
const W = 960, H = 320, PL = 56, PR = 8, PT = 12, PB = 28;
const totals = data.map((d) => LAYER_ORDER.reduce((s, l) => s + d.row[l], 0));
const rawMax = Math.max(...totals, 1);
const step = (() => { const p = 10 ** Math.floor(Math.log10(rawMax)); const r = rawMax / p; return (r <= 2 ? 0.5 : r <= 5 ? 1 : 2) * p; })();
const max = Math.ceil(rawMax / step) * step;
const ticks = Array.from({ length: Math.round(max / step) + 1 }, (_, k) => k * step);
const bw = (W - PL - PR) / data.length;
const barW = Math.max(6, Math.min(40, bw * 0.68));
const y = (v: number) => PT + (H - PT - PB) * (1 - v / max);
const used = LAYER_ORDER.filter((l) => data.some((d) => d.row[l] > 0));
const short = data.length > 12;
const bars = data.map((d, i) => {
  const x = PL + i * bw + (bw - barW) / 2;
  const present = used.filter((l) => d.row[l] > 0);
  let acc = 0;
  const segs = present.map((l, k) => {
    const y0 = acc;
    acc += d.row[l];
    const top = y(acc);
    return { cls: `seg l${layerSlot(l)}`, y: top, h: Math.max(y(y0) - top - 1, 0.5), rx: k === present.length - 1 ? 3 : 0 };
  });
  const tip = [`${d.year}: ${fmt(totals[i])} total`, ...present.map((l) => `${LAYERS[l].name}: ${fmt(d.row[l])}`)].join('\n');
  const label = short ? `'${String(d.year).slice(2)}` : String(d.year);
  return { x, hx: PL + i * bw, segs, tip, label };
});
---
<figure class="viz">
  <figcaption><strong>{title}</strong>{caption && <span class="muted small"> {caption}</span>}</figcaption>
  <ul class="legend" aria-label="Legend">
    {used.map((l) => <li><span class={`dot l${layerSlot(l)}`} />{LAYERS[l].name}</li>)}
  </ul>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} preserveAspectRatio="none">
    {ticks.map((t) => (
      <g>
        <line x1={PL} x2={W - PR} y1={y(t)} y2={y(t)} class="gridline" />
        <text x={PL - 8} y={y(t) + 4} text-anchor="end" class="axis">{fmt(t).replace('n/a', '0')}</text>
      </g>
    ))}
    {bars.map((b) => (
      <g class="bar">
        <rect class="hit" x={b.hx} y={PT} width={bw} height={H - PT - PB}><title>{b.tip}</title></rect>
        {b.segs.map((sg) => <rect class={sg.cls} x={b.x} y={sg.y} width={barW} height={sg.h} rx={sg.rx} />)}
        {b.label && <text x={b.x + barW / 2} y={H - 8} text-anchor="middle" class="axis">{b.label}</text>}
      </g>
    ))}
  </svg>
  <details class="small">
    <summary>Show as table</summary>
    <div class="table-wrap"><table>
      <thead><tr><th>Year</th>{used.map((l) => <th class="num">{LAYERS[l].name}</th>)}<th class="num">Total</th></tr></thead>
      <tbody>{data.map((d, i) => <tr><td>{d.year}</td>{used.map((l) => <td class="num">{fmt(d.row[l])}</td>)}<td class="num">{fmt(totals[i])}</td></tr>)}</tbody>
    </table></div>
  </details>
</figure>
<style>
  .viz { margin: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; min-width: 0; }
  figcaption { margin-bottom: 6px; }
  svg { width: 100%; height: 260px; display: block; overflow: visible; }
  .gridline { stroke: var(--grid); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .axis { fill: var(--muted); font-size: 12px; font-family: var(--sans); }
  .seg { fill: var(--c); stroke: var(--surface); stroke-width: 1; }
  .hit { fill: transparent; }
  .bar:hover .hit { fill: var(--surface-2); }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 14px; padding: 0; margin: 0 0 8px; font-size: 0.82rem; color: var(--text-2); }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  details { margin-top: 8px; color: var(--text-2); }
  details .table-wrap { margin-top: 8px; max-height: 320px; }
  @media (max-width: 600px) { svg { height: 200px; } .axis { font-size: 18px; } }
</style>
