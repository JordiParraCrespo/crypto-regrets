---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'div'> & { title?: string; code: string };
const { title = '', code, class: className, ...rest } = Astro.props;
---
<div class:list={['terminal', className]} {...rest}>
  <div class="terminal-bar" aria-hidden="true"><i></i><i></i><i></i><span>{title}</span></div>
  <pre tabindex="0" aria-label={title || 'code'}><code>{code}</code></pre>
</div>
