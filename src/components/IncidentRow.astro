---
import type { Incident } from '../lib/types';
import { href, fmtUsd, fmtDate } from '../lib/data';
import CategoryChip from './CategoryChip.astro';
interface Props { i: Incident }
const { i } = Astro.props;
---
<tr>
  <td class="mono small" style="white-space:nowrap">{fmtDate(i.date)}</td>
  <td><a href={href(`/hacks/${i.id}`)}>{i.name}</a>{i.poc && <span class="muted small" title="Has DeFiHackLabs PoC"> · PoC</span>}</td>
  <td><CategoryChip id={i.category} /></td>
  <td class="small">{i.chains.slice(0, 3).join(', ')}</td>
  <td class="num">{fmtUsd(i.amountUsd)}</td>
</tr>
