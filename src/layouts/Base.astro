---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import { href } from '../lib/paths';
type Props = SeoProps;
const path = Astro.url.pathname;
const nav = [
  ['/hacks', 'Index'],
  ['/classes', 'Vulnerabilities'],
  ['/trends', 'Trends'],
  ['/ecosystems', 'Ecosystems'],
  ['/infrastructure', 'Infrastructure'],
  ['/developers', 'Developers'],
  ['/sources', 'Method'],
] as const;
const isActive = (p: string) => path.startsWith(href(p));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...Astro.props} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href('/')} aria-label="Crypto Regrets home">
          <img src={href('/favicon.svg')} width="24" height="24" alt="" />
          <span>Crypto Regrets</span>
        </a>
        <nav aria-label="Main">
          {nav.map(([p, label]) => <a href={href(p)} data-astro-prefetch class:list={['nav-link', { active: isActive(p) }]} aria-current={isActive(p) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="actions">
          <a class="btn btn-compact hide-sm" href={href('/data')}>Data</a>
          <a class="btn btn-primary btn-sm" href={href('/hacks')}>Browse hacks</a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <div class="grid cols-4 foot">
        <div>
          <p class="medium" style="margin:0 0 8px">Crypto Regrets</p>
          <p class="caption fog" style="margin:0">A classified index of crypto security failures, for researchers and the developers who fix them. Educational use only.</p>
        </div>
        <div>
          <p class="eyebrow">Explore</p>
          <ul class="foot-links">
            <li><a href={href('/hacks')} data-astro-prefetch>Incident index</a></li>
            <li><a href={href('/classes')} data-astro-prefetch>Vulnerability classes</a></li>
            <li><a href={href('/patterns')} data-astro-prefetch>Failure patterns</a></li>
            <li><a href={href('/trends')} data-astro-prefetch>Trends</a></li>
            <li><a href={href('/ecosystems')} data-astro-prefetch>Ecosystems</a></li>
            <li><a href={href('/history')} data-astro-prefetch>History</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Build</p>
          <ul class="foot-links">
            <li><a href={href('/developers')} data-astro-prefetch>Secure-coding checklist</a></li>
            <li><a href={href('/data')} data-astro-prefetch>Datasets &amp; API</a></li>
            <li><a href={href('/sources')} data-astro-prefetch>Method &amp; sources</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Sources</p>
          <p class="caption fog" style="margin:0">DefiLlama, DeFiHackLabs (Apache-2.0), REKT, SlowMist, BlockSec, RevertIQ and four more, plus Bitcoin Core, Geth, Cosmos and OSV advisories. Classification by analyst labels and TypeSafe Jev. <a class="link" href={href('/sources')}>Method</a></p>
        </div>
      </div>
    </footer>
    <script>
      // Hairline under the sticky header once the page scrolls; cosmetic, so a deferred module is fine.
      const h = document.querySelector('.site-header');
      const onScroll = () => h?.classList.toggle('scrolled', window.scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-paper) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .site-header.scrolled {
    border-bottom-color: var(--color-dove);
  }
  .bar {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 24px;
    flex: 1;
    min-width: 0;
  }
  .nav-link {
    font: 500 14px/20px var(--font-sans);
    color: var(--text-secondary);
    transition: color 0.15s;
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-jet-ink);
  }
  .actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .btn-sm {
    padding: 8px 16px;
  }
  @media (max-width: 960px) {
    .bar {
      height: auto;
      padding-top: 12px;
      padding-bottom: 12px;
      flex-wrap: wrap;
      row-gap: 12px;
    }
    nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      gap: 20px;
      scrollbar-width: none;
      /* Fade the right edge so it reads as a scrollable row, not a cut-off one. */
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
      padding-right: 32px;
    }
    .actions {
      margin-left: auto;
    }
  }
  .site-footer {
    margin-top: 144px;
    padding-bottom: 64px;
  }
  /* The rule sits on the grid, not the padded footer, so it lines up with the content edge. */
  .foot {
    padding-top: 48px;
    border-top: 1px solid var(--color-dove);
  }
  .foot-links {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: grid;
    gap: 6px;
    font-size: 14px;
  }
  .foot-links a {
    color: var(--text-secondary);
  }
  .foot-links a:hover {
    color: var(--color-jet-ink);
  }
  .foot .eyebrow {
    margin: 0;
  }
</style>
